 	return UI_BASIC_key_to_ascii[keycode];
 }
 
@@ -1430,6 +1432,13 @@ static int EditString(int fg, int bg, const char *title,
 				memmove(string + caret + 1, string + caret, i - caret + 1);
 				string[caret++] = (char) ascii;
 			}
+			else if (ascii >= UI_BASIC_KEY_CHAR(0xa0) && ascii <= UI_BASIC_KEY_CHAR(0xff) && i + 2 < size) {
