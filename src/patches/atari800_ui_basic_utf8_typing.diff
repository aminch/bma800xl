From 18ba484d57a36f0eb60cb165efbfa3b0ba6bf695 Mon Sep 17 00:00:00 2001
From: Adam Minchinton <adam.minchinton@gmail.com>
Date: Sun, 11 Oct 2026 19:32:10 +0200
Subject: [PATCH] ui_basic: type characters that have no Atari key

A platform can return UI_BASIC_KEY_CHAR(c) from PLATFORM_Keyboard() for a
key that types a Latin-1 character the Atari has no key for, such as the
Norwegian a ring, o slash and ae. The line editor inserts it as UTF-8, so
names and passwords with them can be typed in the menus.
---
 src/ui_basic.c | 9 +++++++++
 src/ui_basic.h | 7 +++++++
 2 files changed, 16 insertions(+)

diff --git a/src/ui_basic.c b/src/ui_basic.c
index 5774c6e9..1e54c577 100644
--- a/src/ui_basic.c
+++ b/src/ui_basic.c
@@ -307,6 +307,8 @@ static int GetKeyPress(void)
 		}
 	} while (keycode < 0);
 
+	if (keycode >= UI_BASIC_KEY_CHAR_BASE)
+		return keycode;
 	return UI_BASIC_key_to_ascii[keycode];
 }
 
@@ -1430,6 +1432,13 @@ static int EditString(int fg, int bg, const char *title,
 				memmove(string + caret + 1, string + caret, i - caret + 1);
 				string[caret++] = (char) ascii;
 			}
+			else if (ascii >= UI_BASIC_KEY_CHAR(0xa0) && ascii <= UI_BASIC_KEY_CHAR(0xff) && i + 2 < size) {
+				/* as UTF-8 */
+				ch = ascii - UI_BASIC_KEY_CHAR_BASE;
+				memmove(string + caret + 2, string + caret, i - caret + 1);
+				string[caret++] = (char) (0xc0 | (ch >> 6));
+				string[caret++] = (char) (0x80 | (ch & 0x3f));
+			}
 			break;
 		}
 	}
diff --git a/src/ui_basic.h b/src/ui_basic.h
index af84f062..1c194408 100644
--- a/src/ui_basic.h
+++ b/src/ui_basic.h
@@ -15,6 +15,13 @@ extern int UI_BASIC_OnScreenKeyboard(const char *title, int layout);
    or -1 for base keyboard with no function keys */
 #endif
 
+/* PLATFORM_Keyboard() may return UI_BASIC_KEY_CHAR(c), while the UI is
+   active, for a key that types character C (a Unicode code point, U+00A0 to
+   U+00FF) that has no Atari key, such as U+00E5 (a ring) on a Norwegian
+   keyboard. The line editor inserts it; elsewhere it does nothing. */
+#define UI_BASIC_KEY_CHAR_BASE 0x10000
+#define UI_BASIC_KEY_CHAR(c) (UI_BASIC_KEY_CHAR_BASE + (c))
+
 /* used only in the Dreamcast port */
 extern const unsigned char UI_BASIC_key_to_ascii[256];
 
-- 
2.43.0

