 static int mouse_pen_show_pointer = 0;
 static int mouse_last_right = 0;
 static int mouse_last_down = 0;
+static int mouse_trak_move_x = 0;
+static int mouse_trak_move_y = 0;
+static int mouse_trak_steps_x = 0;
+static int mouse_trak_steps_y = 0;
+static int mouse_trak_phase_x = 0;
