 static const UBYTE mouse_amiga_codes[16] = {
 	0x00, 0x02, 0x0a, 0x08,
@@ -422,6 +430,38 @@ static UBYTE mouse_step(void)
 	return r;
 }
 
+static int mouse_trak_steps(int *movement)
+{
+	int steps = *movement / (1 << (MOUSE_SHIFT + 1));
+	if (steps > Atari800_tv_mode)
+		steps = Atari800_tv_mode;
+	else if (steps < -Atari800_tv_mode)
+		steps = -Atari800_tv_mode;
+	*movement -= steps * (1 << (MOUSE_SHIFT + 1));
+	return steps;
+}
+
+static int mouse_trak_step(int steps, int *phase)
+{
+	*phase += steps;
+	if (*phase >= Atari800_tv_mode) {
+		*phase -= Atari800_tv_mode;
+		return 1;
+	}
+	if (*phase <= -Atari800_tv_mode) {
+		*phase += Atari800_tv_mode;
+		return -1;
+	}
+	return 0;
+}
+
+static UBYTE mouse_trak_code(void)
+{
+	/* bit 3: vertical clock, bit 2: down; bit 1: horizontal clock, bit 0: right */
+	return ((mouse_y & 1) << 3) | (mouse_last_down << 2)
+	     | ((mouse_x & 1) << 1) | mouse_last_right;
+}
