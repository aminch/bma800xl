+/* Plots up to n characters of a string. Returns the column after them. */
+static int PrintChars(int fg, int bg, const char *string, int n, int x, int y)
+{
+	while (n-- > 0 && *string != '\0') {
+		int ch;
+		string += DecodeChar(string, &ch);
+		Plot(fg, bg, ch, x++, y);
+	}
+	return x;
+}
