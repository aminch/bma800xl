+/* Strings shown by the UI are in UTF-8. A byte that does not start a valid
+   UTF-8 sequence is taken as a Latin-1 character, so that text in that
+   encoding (file names on some systems) is shown correctly too. */
+
+/* Reads one character from a string. Returns the number of bytes used. */
+static int DecodeChar(const char *s, int *ch)
+{
+	const UBYTE *p = (const UBYTE *) s;
+	int len;
+	int min;
+	int c;
+	int i;
+	if (p[0] >= 0xc2 && p[0] <= 0xdf) {
+		len = 2;
+		min = 0x80;
+		c = p[0] & 0x1f;
+	}
+	else if (p[0] >= 0xe0 && p[0] <= 0xef) {
+		len = 3;
+		min = 0x800;
+		c = p[0] & 0x0f;
+	}
+	else if (p[0] >= 0xf0 && p[0] <= 0xf4) {
+		len = 4;
+		min = 0x10000;
+		c = p[0] & 0x07;
+	}
+	else {
+		*ch = p[0];
+		return 1;
+	}
+	for (i = 1; i < len; i++) {
+		if ((p[i] & 0xc0) != 0x80) {
+			*ch = p[0];
+			return 1;
+		}
+		c = (c << 6) | (p[i] & 0x3f);
+	}
+	if (c < min || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff)) {
+		*ch = p[0];
+		return 1;
+	}
+	*ch = c;
+	return len;
+}
+
+/* Returns the number of characters (not bytes) in a string. */
+static int StrWidth(const char *s)
+{
+	int n = 0;
+	int ch;
+	while (*s != '\0') {
+		s += DecodeChar(s, &ch);
+		n++;
+	}
+	return n;
+}
+
+/* Returns a pointer to what follows the first n characters of a string. */
+static const char *StrSkip(const char *s, int n)
+{
+	int ch;
+	while (n-- > 0 && *s != '\0')
+		s += DecodeChar(s, &ch);
+	return s;
+}
