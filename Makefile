#
# Makefile for the BMA800XL kernel image.
#
# Run ./build_deps.sh once first; it builds circle-stdlib for the board.
# Then "make" produces the kernel image (kernel8-32.img for the Pi 3) and
# "make sdcard" a folder to copy onto a FAT32 SD card.
#

ROOT := $(CURDIR)

ifeq ($(wildcard third_party/circle-stdlib/Config.mk),)
$(error circle-stdlib is not configured. Run ./build_deps.sh first)
endif

include third_party/circle-stdlib/Config.mk

BMA800XL_VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
A8_DIR := third_party/atari800/src
A8_VERSION := $(shell grep -m1 '^AC_INIT' third_party/atari800/configure.ac | cut -d, -f2 | tr -d ' []')

include src/port/atari800.mk

BUILD := build
A8_OBJS := $(addprefix $(BUILD)/atari800/,$(A8_SRCS:.c=.o))
A8_LIB := $(BUILD)/libatari800.a

OBJS = src/main.o src/kernel.o src/options.o src/fbl.o src/crt_pi_idx.o \
       src/crt_pi_rgb.o src/vchiqsound.o src/vchiqsoundbasedevice.o \
       src/port/platform.o src/port/keyboard.o src/port/fswrap.o

include $(CIRCLEHOME)/Rules.mk

INCLUDE := $(CIRCLE_STDLIB_INCLUDES) $(INCLUDE) -I $(CIRCLEHOME)/addon/fatfs

# See src/port/fswrap.c
LDFLAGS += --wrap=stat

VERSION_DEFINES = -DBMA800XL_VERSION=\"$(BMA800XL_VERSION)\" -DA8_VERSION=\"$(A8_VERSION)\"
CFLAGS += $(VERSION_DEFINES)
CPPFLAGS += $(VERSION_DEFINES)

# The port's C files include atari800 headers, and src/port/config.h must be
# found before anything else called config.h.
src/port/%.o src/port/%.d: CFLAGS += -I src/port -I $(A8_DIR)

# atari800 itself: compiled into build/ so the submodule stays clean.
A8_CFLAGS = -I src/port -I $(A8_DIR) -w

$(BUILD)/atari800/%.o: $(A8_DIR)/%.c src/port/config.h
	@mkdir -p $(dir $@)
	@echo "  CC    $<"
	@$(CC) $(CFLAGS) $(A8_CFLAGS) $(C_STANDARD) -c -o $@ $<

$(A8_LIB): $(A8_OBJS)
	@echo "  AR    $@"
	@rm -f $@
	@$(AR) cr $@ $(A8_OBJS)

# atari800's configure writes src/config.h, which would be picked up instead
# of src/port/config.h. It must not exist in the submodule.
check-submodule:
	@if [ -f $(A8_DIR)/config.h ]; then \
		echo "Remove $(A8_DIR)/config.h (generated by atari800's configure)"; \
		exit 1; \
	fi

$(TARGET).img: check-submodule $(A8_LIB)

LIBS := $(A8_LIB) \
	$(CIRCLE_STDLIB_INSTALL_DIR)/lib/libm.a \
	$(CIRCLE_STDLIB_INSTALL_DIR)/lib/libc.a \
	$(CIRCLE_STDLIB_INSTALL_DIR)/lib/libcirclenewlib.a \
	$(CIRCLEHOME)/addon/SDCard/libsdcard.a \
	$(CIRCLEHOME)/lib/usb/libusb.a \
	$(CIRCLEHOME)/lib/input/libinput.a \
	$(CIRCLEHOME)/addon/fatfs/libfatfs.a \
	$(CIRCLEHOME)/lib/fs/libfs.a \
	$(CIRCLEHOME)/addon/vc4/vchiq/libvchiq.a \
	$(CIRCLEHOME)/addon/vc4/interface/bcm_host/libbcm_host.a \
	$(CIRCLEHOME)/addon/vc4/interface/khronos/libkhrn_client.a \
	$(CIRCLEHOME)/addon/vc4/interface/vmcs_host/libvmcs_host.a \
	$(CIRCLEHOME)/addon/vc4/interface/vcos/libvcos.a \
	$(CIRCLEHOME)/addon/linux/liblinuxemu.a \
	$(CIRCLEHOME)/lib/sound/libsound.a \
	$(CIRCLEHOME)/lib/sched/libsched.a \
	$(CIRCLEHOME)/lib/libcircle.a

EXTRACLEAN += $(OBJS) src/port/*.d src/*.d
.PHONY: check-submodule sdcard distclean

# A folder with everything that goes on the SD card.
sdcard: $(TARGET).img
	@./make_sdcard.sh $(TARGET).img

distclean: clean
	rm -rf $(BUILD) sdcard_out

-include $(DEPS)
